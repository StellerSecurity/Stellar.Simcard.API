APP_NAME="Stellar eSIM API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stellar_simcard
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Internal service-to-service Basic Auth used by /api/v1/sim and top-up routes.
APPSETTING_API_USERNAME_STELLAR_SIM_API=
APPSETTING_API_PASSWORD_STELLAR_SIM_API=

# eSIM privacy keys. Store production values in Azure Key Vault references.
ESIM_PLAN_HASH_KEY=
ESIM_PLAN_MASTER_KEY=

# Optional Stellar-user association. Generate a separate random key; never reuse APP_KEY.
# Example generator: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
ESIM_USER_REF_HASH_VERSION=1
ESIM_USER_REF_HASH_KEY_V1=
ESIM_USER_REF_HASH_KEY_V2=
ESIM_USER_REF_HASH_KEY_V3=

# eSIMAccess current account (all new orders)
ESIMACCESS_BASE_URL=
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=

# eSIMAccess previous account (existing eSIMs/top-ups)
ESIMACCESS_LEGACY_ACCESS_CODE=
ESIMACCESS_LEGACY_SECRET_KEY=
ESIMACCESS_TOPUP_PATH=
ESIMACCESS_WEBHOOK_SECRET=

# Checkout/top-up service integration
STELLAR_DATA_TOPUP_URL=
STELLAR_DATA_TOPUP_CHECKOUT_URL=
STELLAR_COMMERCE_TOPUP_CHECKOUT_URL=
STELLAR_COMMERCE_AUTO_TOPUP_CHARGE_URL=https://stellarcommerceapiprod.azurewebsites.net/api/v1/esimautotopupcontroller/charge
STELLAR_COMMERCE_AUTO_TOPUP_AUTHORIZATION_STATUS_URL=https://stellarcommerceapiprod.azurewebsites.net/api/v1/esimautotopupcontroller/authorization/status
STELLAR_COMMERCE_AUTO_TOPUP_AUTHORIZATION_URL=https://stellarcommerceapiprod.azurewebsites.net/api/v1/esimautotopupcontroller/authorization
APPSETTING_API_USERNAME_STELLAR_COMMERCE_API=
APPSETTING_API_PASSWORD_STELLAR_COMMERCE_API=

# Stellar notifications
STELLAR_NOTIFICATIONS_BASE_URL=
STELLAR_NOTIFICATIONS_BASIC_USERNAME=
STELLAR_NOTIFICATIONS_BASIC_PASSWORD=

# Stellar eSIM first-usage marketing refund offer
STELLAR_ESIM_MARKETING_REFUND_ENABLED=true
STELLAR_ESIM_MARKETING_REFUND_PRODUCT=stellar-esim-marketing-reward
STELLAR_ESIM_MARKETING_REFUND_EVENT=esim_first_usage_detected
STELLAR_ESIM_MARKETING_REFUND_AMOUNT=10
STELLAR_ESIM_MARKETING_REFUND_DISCOUNT_PERCENTAGE=20
STELLAR_ESIM_MARKETING_REFUND_SUPPORT_EMAIL=info@stellarsecurity.com
STELLAR_ESIM_MARKETING_REFUND_RETRY_AFTER_MINUTES=15
STELLAR_ESIM_MARKETING_REFUND_BATCH_SIZE=100

# Isolated post-response relay of eSIMAccess webhooks to Stellar Wholesale.
# The existing eSIMAccess webhook controller/service is not changed.
STELLAR_WHOLESALE_WEBHOOK_RELAY_URL=https://wholesale.stellarsecurity.com/api/internal/simcard/provider-webhook
STELLAR_WHOLESALE_WEBHOOK_RELAY_SECRET=
STELLAR_WHOLESALE_WEBHOOK_RELAY_CONNECT_TIMEOUT=2
STELLAR_WHOLESALE_WEBHOOK_RELAY_TIMEOUT=5
